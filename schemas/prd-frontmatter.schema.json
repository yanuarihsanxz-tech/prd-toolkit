{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prd-toolkit:schema:prd-frontmatter:1",
  "title": "PRD Frontmatter",
  "$comment": "The validator additionally enforces current_milestone <= total_milestones and requires a brand-new draft to start at milestone 0. Use implementation while builder-verified milestones advance; approved remains an owner verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "version",
    "status",
    "current_milestone",
    "total_milestones",
    "type",
    "tech_stack",
    "created",
    "ai_instructions"
  ],
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": ["draft", "implementation", "approved", "superseded"]
    },
    "current_milestone": {
      "type": "integer",
      "minimum": 0
    },
    "total_milestones": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "enum": ["app", "tool"]
    },
    "tech_stack": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "ai_instructions": {
      "type": "string",
      "minLength": 1
    },
    "authority_policy": {
      "type": "integer",
      "enum": [1],
      "description": "Optional fixed authority format version. Absence selects legacy checks, not authorization."
    }
  }
}
