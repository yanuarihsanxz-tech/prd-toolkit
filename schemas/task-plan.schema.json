{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prd-toolkit:schema:task-plan:2",
  "title": "Local Evidence-Gated Delivery-Slice Plan v2",
  "$comment": "The runner additionally enforces placeholder rejection, project-relative bounded paths, PRD file existence, contiguous/non-decreasing phases, phase_total equality, earlier-only dependencies, unique verification IDs, production authorization, and exact plan fingerprint binding. New plans default to two or three outcome-oriented milestone tasks including final audit, use four only when justified, and never exceed five; the wider array bound remains only for compatibility with historical schema-v2 plans. Phase and layer are progress metadata, not approval gates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan", "tasks"],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "prd",
        "prd_version",
        "source_fingerprint",
        "generated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "prd": {
          "type": "string",
          "minLength": 1
        },
        "prd_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "source_fingerprint": {
          "type": "string",
          "pattern": "^(git|sha256|manifest-sha256):[A-Za-z0-9][A-Za-z0-9._:+-]*$"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "title",
          "objective",
          "layer",
          "phase",
          "phase_total",
          "page",
          "requirement_ids",
          "acceptance_criteria_ids",
          "depends_on",
          "allowed_paths",
          "forbidden_paths",
          "verification",
          "authority",
          "max_attempts"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9._-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "phase": {
            "type": "integer",
            "minimum": 1
          },
          "phase_total": {
            "type": "integer",
            "minimum": 1
          },
          "page": {
            "type": ["string", "null"]
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(FR|NFR)-[0-9]{3}$"
            }
          },
          "acceptance_criteria_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^AC-[0-9]{3}$"
            }
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9][A-Z0-9._-]*$"
            }
          },
          "allowed_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "forbidden_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "method",
                "environment",
                "procedure",
                "expected_result",
                "evidence_required",
                "timeout_seconds",
                "cleanup"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^VER-[0-9]{3}$"
                },
                "method": {
                  "enum": [
                    "command",
                    "inspection",
                    "test",
                    "build",
                    "lint",
                    "typecheck",
                    "smoke",
                    "manual"
                  ]
                },
                "environment": {
                  "type": "string",
                  "minLength": 1
                },
                "procedure": {
                  "type": "string",
                  "minLength": 1
                },
                "expected_result": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_required": {
                  "type": "string",
                  "minLength": 1
                },
                "timeout_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 86400
                },
                "cleanup": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "authority": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "execution_mode",
              "allowed_side_effects",
              "forbidden_side_effects",
              "requires_owner_authorization"
            ],
            "properties": {
              "execution_mode": {
                "enum": [
                  "read_only",
                  "dry_run",
                  "local_test",
                  "staging",
                  "production"
                ]
              },
              "allowed_side_effects": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "forbidden_side_effects": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "requires_owner_authorization": {
                "type": "boolean"
              }
            }
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        }
      }
    }
  }
}
