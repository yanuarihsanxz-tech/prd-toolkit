      "output": "examples/tool-prd-example.md",
      "expected_type": "tool",
      "mutation": {
        "find": "ai_instructions: \"#builder-capability-routing-contract\"",
        "replace": "ai_instructions: \"#missing-builder\""
      },
      "expected_valid": false,
      "required_contracts": [],
