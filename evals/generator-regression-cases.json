    },
    {
      "id": "reject-placeholder-builder-routing",
      "rough_idea": "Regression mutation: a routing row retains unresolved template cells.",
      "output": "examples/tool-prd-example.md",
      "expected_type": "tool",
      "mutation": {
        "find": "| Before implementation planning | Capability discovery and repository grounding | Host-provided skill/tool catalog plus repository instructions | Read `AGENTS.md`, workflow exports, schemas, source, and tests directly | Selected routes and unavailable candidates recorded in the plan summary | Read-only local inspection allowed |",
        "replace": "| [Trigger detail] | [Capability needed] | [Preferred route] | [Fallback procedure] | [Evidence needed] | [Authority boundary] |"
      },
      "expected_valid": false,
      "required_contracts": [],
      "expected_finding_codes": [
        "BUILDER_ROUTING_UNRESOLVED"
      ]
    },
    {
      "id": "native-local-build-authority",
      "rough_idea": "A native local build uses explicit user build authority without requiring a runner-approval phrase.",
      "output": "examples/tool-prd-example.md",
      "expected_type": "tool",
      "mutation": {
        "find": "One exact plan approval covers declared local runner transitions.",
        "replace": "Runner transitions follow the recorded plan."
      },
      "expected_valid": true,
      "required_contracts": [
        "Builder Capability Routing Contract"
      ],
      "expected_finding_codes": []
    },
    {
      "id": "reject-missing-embedded-builder-entry",
